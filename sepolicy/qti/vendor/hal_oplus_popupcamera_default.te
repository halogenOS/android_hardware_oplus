type hal_oplus_popupcamera_default, domain, vendor_hal_oplus_popupcamera_server;
type hal_oplus_popupcamera_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_oplus_popupcamera_default)
hal_server_domain(hal_oplus_popupcamera_default, vendor_hal_oplus_popupcamera)
binder_use(hal_oplus_popupcamera_default)
binder_call(hal_oplus_popupcamera_default, servicemanager)
hal_attribute_service(vendor_hal_oplus_popupcamera, hal_oplus_popupcamera_aidl_service)
binder_call(vendor_hal_oplus_popupcamera_client, vendor_hal_oplus_popupcamera_server)
